# Browser-safe Supabase settings used by the authenticated operations UI.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_APP_NAME=Wedge Ethiopia

# Server-only Supabase credentials used by machine API routes/workers. Never expose this key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Fiscal authority adapter: mock | mor
FISCAL_ADAPTER=mock
MOR_BASE_URL=
MOR_CLIENT_ID=
MOR_CLIENT_SECRET=

# eSignet / Fayda relying-party configuration
ESIGNET_ISSUER=
ESIGNET_AUTHORIZATION_ENDPOINT=
ESIGNET_TOKEN_ENDPOINT=
ESIGNET_JWKS_URI=
ESIGNET_CLIENT_ID=
ESIGNET_REDIRECT_URI=http://localhost:3000/api/v1/identity/callback
ESIGNET_PRIVATE_KEY_JWK=
# Exactly 32 random bytes, base64 encoded. Encrypts PKCE verifiers at rest.
IDENTITY_SESSION_ENCRYPTION_KEY_BASE64=

# Webhook signing key in PKCS8 DER base64; key id must be stable during overlap rotations.
WEBHOOK_SIGNING_KEY_ID=dev-key-1
WEBHOOK_ED25519_PRIVATE_KEY_DER_BASE64=

# Protects internal worker endpoints if you run them over HTTP.
INTERNAL_WORKER_SECRET=

# Development only. If true and Supabase UI credentials are absent, dashboard pages render synthetic data.
ALLOW_DEMO_MODE=true

# Separate Ed25519 key for signed daily audit checkpoints.
AUDIT_CHECKPOINT_SIGNING_KEY_ID=audit-dev-key-1
AUDIT_CHECKPOINT_ED25519_PRIVATE_KEY_DER_BASE64=
